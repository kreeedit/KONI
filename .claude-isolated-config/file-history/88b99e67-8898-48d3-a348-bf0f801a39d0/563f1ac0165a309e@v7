/* KONI reader — "scholarly edition" stylesheet.
   Typography-first and flat: hairline rules instead of shadows, small-caps
   sans apparatus against serif prose, one accent. No framework, no build step. */

:root {
  /* Cardo carries the polytonic Greek; UI prose uses a local system serif, and
     the apparatus (labels, URNs, ids, counts) a local system sans. Only Cardo
     is fetched — one external request instead of three. */
  --font-greek: 'Cardo', 'Gentium Plus', 'Palatino Linotype', Palatino, 'Times New Roman', serif;
  --font-ui: Georgia, 'Iowan Old Style', 'Palatino Linotype', Palatino, ui-serif, serif;
  --font-meta: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;

  --reader-size: 20px;
  --reader-lh: 1.8;
  --radius: 2px;

  /* light — warm paper, ink, one oxblood accent */
  --bg: #faf8f3;
  --bg-elev: #fffefb;
  --bg-soft: #f2efe7;
  --text: #1a1a1a;
  --text-soft: #4a463e;
  --text-faint: #6f6a5e;
  --rule: #e3ded3;
  --rule-strong: #cfc8b8;
  --accent: #7a2e2e;
  --accent-soft: #a86a6a;
  --match: #2f6b4a;
  --match-bg: #e8f0ea;
  --bridge: #8a6a3a;
  --bridge-bg: rgba(138, 106, 58, .13);
}

body[data-theme="dark"] {
  --bg: #171612;
  --bg-elev: #1e1d19;
  --bg-soft: #26241f;
  --text: #e8e5dd;
  --text-soft: #b0aca1;
  --text-faint: #928d81;
  --rule: #302e28;
  --rule-strong: #4a473e;
  --accent: #cf8f8f;
  --accent-soft: #a86a6a;
  --match: #7fbf9a;
  --match-bg: #1c2a21;
  --bridge: #cfa36a;
  --bridge-bg: rgba(207, 163, 106, .15);
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-ui);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

/* A single, consistent focus ring for keyboard users. */
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

/* Shared apparatus voice: the small letterspaced caps a critical edition uses
   for running heads, labels and shelf numbers. */
.apparatus {
  font-family: var(--font-meta);
  font-size: .68rem;
  letter-spacing: .13em;
  text-transform: uppercase;
  color: var(--text-faint);
}

/* ---- masthead ---- */
.topbar {
  position: sticky; top: 0; z-index: 20;
  display: flex; align-items: baseline; gap: 1.2rem;
  padding: .95rem 1.4rem .8rem;
  background: var(--bg);
  border-bottom: 1px solid var(--rule-strong);
}
.brand {
  font-family: var(--font-meta);
  font-size: .82rem; font-weight: 500;
  color: var(--text);
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: .38em;
  /* letterspacing adds a trailing gap; pull the optical edge back */
  margin-right: -.38em;
}
.brand:hover { color: var(--accent); }
.top-nav { display: flex; gap: 1.5rem; margin-left: auto; }
.top-nav a {
  font-family: var(--font-meta); font-size: .68rem; font-weight: 400;
  letter-spacing: .13em; text-transform: uppercase;
  color: var(--text-faint); text-decoration: none;
  padding-bottom: .18rem;
  border-bottom: 1px solid transparent;
  transition: color .12s, border-color .12s;
}
.top-nav a:hover { color: var(--text); }
.top-nav a.active { color: var(--text); border-bottom-color: var(--accent); }
.top-actions { display: flex; gap: .1rem; }
.icon-btn {
  font-family: var(--font-meta); font-size: .72rem;
  letter-spacing: .06em;
  border: none; background: none;
  color: var(--text-faint);
  cursor: pointer;
  padding: .2rem .38rem;
  transition: color .12s;
}
.icon-btn:hover { color: var(--accent); }

/* ---- layout shell ---- */
main { max-width: 1140px; margin: 0 auto; padding: 2.2rem 1.4rem 4rem; }
.footer {
  text-align: center;
  padding: 1.6rem 1.4rem 2.4rem;
  border-top: 1px solid var(--rule);
  margin-top: 3rem;
  font-family: var(--font-meta); font-size: .66rem;
  letter-spacing: .1em; text-transform: uppercase;
  color: var(--text-faint);
}
.footer-name { display: block; color: var(--text-soft); letter-spacing: .16em; }
.footer-src { display: block; margin-top: .4rem; letter-spacing: .08em; text-transform: none; }

/* ---- home / search ---- */
.search-wrap { position: relative; max-width: 34rem; margin: 0 auto 1.6rem; }
.search-input {
  width: 100%;
  font-size: 1.15rem; font-family: var(--font-greek);
  padding: .7rem .2rem;
  border: none; border-bottom: 1px solid var(--rule-strong);
  border-radius: 0;
  background: transparent; color: var(--text);
  transition: border-color .12s;
}
.search-input::placeholder { color: var(--text-faint); }
.search-input:focus { outline: none; border-bottom-color: var(--accent); }
.search-icon {
  position: absolute; left: 0; top: 50%; transform: translateY(-50%);
  color: var(--text-faint); font-size: .95rem;
}
/* the field is underline-only, so indent the text past the leading glyph */
.search-input { padding-left: 1.5rem; }
.search-hint {
  text-align: center; color: var(--text-faint); font-size: .78rem;
  margin: 0 0 2rem;
  font-family: var(--font-meta); letter-spacing: .04em;
}

.result-list { list-style: none; margin: 0; padding: 0; }
.result {
  display: grid; grid-template-columns: 3.6rem 1fr auto; gap: 1.2rem; align-items: baseline;
  padding: .7rem .2rem;
  border-bottom: 1px solid var(--rule);
  cursor: pointer;
  transition: border-color .12s;
}
.result:hover { border-bottom-color: var(--rule-strong); }
.result:hover .name-latin { color: var(--accent); }
.result .aid {
  font-family: var(--font-meta); font-variant-numeric: tabular-nums;
  color: var(--text-faint); font-size: .7rem; letter-spacing: .06em;
}
.result .name-latin {
  font-family: var(--font-greek); font-size: 1.15rem;
  color: var(--text); transition: color .12s;
}
.result .name-greek { font-family: var(--font-greek); color: var(--text-soft); margin-left: .6rem; }
.result .meta { color: var(--text-faint); font-size: .78rem; margin-top: .15rem; }
.result .name-greek.greek-empty { display: none; }
.result .count {
  font-family: var(--font-meta); font-size: .68rem;
  letter-spacing: .06em; text-transform: uppercase;
  color: var(--text-faint); text-align: right; white-space: nowrap;
}
.result .count .read { color: var(--match); }

/* ---- author page ---- */
.author-card {
  border-bottom: 1px solid var(--rule-strong);
  padding: 0 0 1.2rem;
  margin-bottom: 1.8rem;
}
.author-name {
  font-family: var(--font-greek); font-size: 2rem; font-weight: 400;
  color: var(--text); margin: 0;
}
.author-name .gr { color: var(--accent); margin-left: .8rem; font-size: 1.55rem; }
.author-meta { color: var(--text-soft); margin-top: .5rem; font-size: .92rem; }
.author-meta .pill {
  display: inline-block; padding: .1rem .5rem; margin-right: .5rem;
  border: 1px solid var(--rule); border-radius: var(--radius);
  font-family: var(--font-meta); font-size: .64rem;
  letter-spacing: .1em; text-transform: uppercase;
  color: var(--text-soft);
}
.author-id {
  font-family: var(--font-meta); color: var(--text-faint);
  font-size: .68rem; letter-spacing: .1em; text-transform: uppercase;
}
.back-link {
  font-family: var(--font-meta); font-size: .68rem;
  letter-spacing: .12em; text-transform: uppercase;
  color: var(--accent); text-decoration: none;
  display: inline-block; margin-bottom: 1.2rem;
}
.back-link::before { content: "← "; }
.back-link:hover { color: var(--text); }

.section-head {
  font-family: var(--font-meta); font-size: .68rem; font-weight: 400;
  letter-spacing: .16em; text-transform: uppercase;
  color: var(--text-faint);
  margin: 2rem 0 .9rem;
  padding-bottom: .4rem;
  border-bottom: 1px solid var(--rule);
}

.works-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 0; }
.work {
  display: flex; gap: .7rem; align-items: flex-start;
  padding: .7rem .2rem;
  border-bottom: 1px solid var(--rule);
  transition: border-color .12s;
}
.work.readable { cursor: pointer; }
.work.readable:hover { border-bottom-color: var(--rule-strong); }
.work.readable:hover .w-title { color: var(--accent); }
.work.unreadable { opacity: .5; }
.work .badge {
  flex: 0 0 auto;
  font-family: var(--font-meta); font-size: .72rem;
  color: var(--text-faint); margin-top: .12rem;
}
.work.readable .badge { color: var(--match); }
.work .w-title {
  font-family: var(--font-greek); font-size: 1.05rem;
  color: var(--text); transition: color .12s;
}
.work .w-gr { color: var(--accent); font-size: .9rem; display: block; }
.work .w-urn {
  font-family: var(--font-meta); font-size: .64rem;
  letter-spacing: .04em; color: var(--text-faint);
  word-break: break-all; margin-top: .2rem;
}
.work .w-no { font-family: var(--font-meta); font-size: .64rem; color: var(--text-faint); }

/* ---- reader ---- */
.reader { display: grid; grid-template-columns: 13rem 1fr; gap: 2.6rem; align-items: start; }
.reader-nav {
  position: sticky; top: 4.6rem; max-height: calc(100vh - 6rem); overflow: auto;
  border-right: 1px solid var(--rule);
  padding-right: 1rem;
}
.reader-nav h4 {
  margin: 0 0 .7rem;
  font-family: var(--font-meta); font-size: .64rem; font-weight: 400;
  letter-spacing: .16em; text-transform: uppercase;
  color: var(--text-faint);
}
.nav-item {
  display: block; padding: .35rem 0; cursor: pointer;
  font-family: var(--font-meta); font-size: .76rem;
  color: var(--text-faint);
  border: none; background: none; width: 100%; text-align: left;
  transition: color .12s;
}
.nav-item:hover { color: var(--text); }
.nav-item.active { color: var(--accent); }
.nav-item .nav-meta { float: right; color: var(--text-faint); font-size: .68rem; }

.reader-pane { min-width: 0; }
.reader-title {
  font-family: var(--font-greek); font-size: 1.7rem; font-weight: 400;
  color: var(--text); margin: 0 0 .2rem;
}
.reader-title .gr { color: var(--accent); margin-left: .6rem; font-size: 1.35rem; }
.reader-sub {
  color: var(--text-faint); font-size: .78rem; margin-bottom: 1.8rem;
  padding-bottom: .9rem; border-bottom: 1px solid var(--rule);
}
.reader-sub .urn { font-family: var(--font-meta); letter-spacing: .04em; }
.reader-sub .w-edition { margin-top: .3rem; max-width: 46rem; }
.w-edition {
  font-family: var(--font-ui); font-size: .78rem; color: var(--text-soft);
  font-style: italic; margin-top: .2rem; line-height: 1.4;
}

.greek-text {
  font-family: var(--font-greek);
  font-size: var(--reader-size);
  line-height: var(--reader-lh);
  color: var(--text);
  max-width: 44rem;
}
.greek-text .block-head {
  font-family: var(--font-greek); font-weight: 400; font-size: 1.12em;
  color: var(--accent); margin: 2rem 0 .8rem;
  padding-bottom: .3rem;
  border-bottom: 1px solid var(--rule);
}
.greek-text .para { margin: 0 0 1.2rem; text-indent: 1.4em; hyphens: auto; }
.greek-text .line {
  display: grid; grid-template-columns: 3rem 1fr; gap: .6rem; margin: 0 0 .15rem;
}
.greek-text .line .lnum {
  font-family: var(--font-meta); font-size: .62rem;
  color: var(--text-faint); text-align: right;
  padding-top: .55em; font-variant-numeric: tabular-nums;
}
.greek-text .line .ltext { white-space: pre-wrap; }

/* ---- sources panel ---- */
.sources {
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  padding: .7rem 0;
  margin-bottom: 2rem;
}
.sources > summary {
  cursor: pointer;
  font-family: var(--font-meta); font-weight: 400; font-size: .66rem;
  letter-spacing: .14em; text-transform: uppercase;
  color: var(--accent);
  list-style: none; user-select: none;
}
.sources > summary::before { content: "▸ "; }
.sources[open] > summary::before { content: "▾ "; }
.src-list {
  margin-top: 0; display: grid; gap: 0; overflow: hidden;
  max-height: 0; opacity: 0; padding-top: 0;
  transition: max-height .28s ease, opacity .22s ease, margin-top .28s ease;
}
.sources[open] .src-list { max-height: 5000px; opacity: 1; margin-top: .6rem; }
.src-link {
  display: grid; grid-template-columns: 8rem 1fr; gap: .8rem; align-items: start;
  padding: .55rem .6rem;
  border: none; border-bottom: 1px solid var(--rule);
  border-left: 2px solid transparent;
  text-decoration: none; color: var(--text);
  transition: border-color .12s, background .12s;
}
.src-link:hover { background: var(--bg-soft); }
.src-link.confirmed { border-left-color: var(--match); }
.src-link.search { border-left-color: var(--rule-strong); }
.src-badge {
  font-family: var(--font-meta); font-size: .62rem;
  letter-spacing: .1em; text-transform: uppercase;
  color: var(--text-faint); padding-top: .15rem;
}
.src-link.confirmed .src-badge { color: var(--match); }
.src-body { display: flex; flex-direction: column; gap: .12rem; min-width: 0; }
.src-label { font-weight: 400; font-size: .9rem; word-break: break-word; }
.src-detail { font-size: .78rem; color: var(--text-faint); }
.src-kind {
  font-family: var(--font-meta); font-size: .6rem;
  letter-spacing: .1em; text-transform: uppercase; color: var(--accent);
}
@media (max-width: 760px) { .src-link { grid-template-columns: 1fr; } }

.reader-empty {
  text-align: center; color: var(--text-soft); padding: 4rem 1rem;
  font-family: var(--font-greek); font-size: 1.1rem;
}
.spinner {
  font-family: var(--font-meta); font-size: .68rem;
  letter-spacing: .14em; text-transform: uppercase;
  color: var(--text-faint); padding: 3rem; text-align: center;
}
.stats {
  max-width: 34rem; margin: 0 auto 1.6rem;
  font-family: var(--font-meta); font-size: .7rem;
  letter-spacing: .06em; text-transform: uppercase;
  color: var(--text-faint);
}
.stats b { color: var(--text-soft); font-variant-numeric: tabular-nums; }
.stats #count { color: var(--match); }
#more { text-align: center; margin-top: 2rem; }
.more-btn {
  font-family: var(--font-meta); font-size: .68rem; font-weight: 400;
  letter-spacing: .14em; text-transform: uppercase;
  padding: .55rem 1.3rem; border-radius: var(--radius); cursor: pointer;
  border: 1px solid var(--rule-strong); background: none; color: var(--text-soft);
  transition: color .12s, border-color .12s;
}
.more-btn:hover { color: var(--accent); border-color: var(--accent-soft); }
#count { color: var(--accent); }

/* ---- toast ---- */
.toast {
  position: fixed; bottom: 1.6rem; left: 50%; transform: translateX(-50%);
  background: var(--text); color: var(--bg);
  padding: .55rem 1.1rem; border-radius: var(--radius);
  font-family: var(--font-meta); font-size: .68rem;
  letter-spacing: .08em; text-transform: uppercase;
  z-index: 50; opacity: .96;
}

/* ---- compare view ---- */
.page-title {
  font-family: var(--font-greek); font-size: 1.8rem; font-weight: 400;
  color: var(--text); margin: 0 0 .4rem;
}
.page-intro {
  color: var(--text-soft); font-size: .9rem; line-height: 1.6;
  max-width: 46rem; margin-bottom: 1.8rem;
}
.page-intro code {
  font-family: var(--font-meta); background: var(--bg-soft);
  padding: .05rem .3rem; border-radius: var(--radius); font-size: .78rem;
}
.cmp-form { display: flex; gap: .8rem; flex-wrap: wrap; margin-bottom: 1.4rem; }
.cmp-input {
  font-family: var(--font-meta); font-size: .85rem; padding: .5rem .6rem;
  border: 1px solid var(--rule); border-radius: var(--radius);
  background: var(--bg-elev); color: var(--text); width: 12rem;
}
.cmp-input:focus { outline: none; border-color: var(--accent); }
.cmp-info {
  border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
  padding: .7rem 0; font-size: .82rem; color: var(--text-soft); margin-bottom: 1.2rem;
}
.cmp-info b { color: var(--accent); font-weight: 400; }
.cmp-info .muted { color: var(--text-faint); font-size: .74rem; }
.cmp-controls { display: flex; gap: 1.8rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
.cmp-controls label {
  font-family: var(--font-meta); font-size: .68rem;
  letter-spacing: .08em; text-transform: uppercase;
  color: var(--text-faint);
  display: flex; align-items: center; gap: .6rem;
}
.cmp-controls input[type=range] { width: 10rem; accent-color: var(--accent); }
.cmp-controls label.live { color: var(--accent); }
.cmp-controls label.live::after {
  content: " ⟳ recompute"; font-size: .6rem; color: var(--text-faint);
}
/* A toggle that applies immediately, unlike the .live sliders above — so it
   must NOT carry the "⟳ recompute" suffix that .live appends. */
.cmp-controls label.live-toggle { color: var(--text-faint); }
.cmp-controls label.live-toggle:hover { color: var(--accent); }
.cmp-controls input[type=checkbox] { accent-color: var(--accent); }
.slider-val { color: var(--accent); font-variant-numeric: tabular-nums; min-width: 2rem; }
.cmp-pairs { display: grid; gap: 0; }
.cmp-pair {
  border-bottom: 1px solid var(--rule-strong);
  padding: 1.4rem 0;
}
.cmp-pair-head {
  display: flex; gap: .9rem; align-items: baseline;
  margin-bottom: .9rem; flex-wrap: wrap;
}
.cmp-score {
  font-family: var(--font-meta); font-size: .64rem;
  letter-spacing: .08em;
  color: var(--match); border: 1px solid var(--match);
  padding: .1rem .45rem; border-radius: var(--radius);
  font-variant-numeric: tabular-nums;
}
.cmp-pair-sec { font-family: var(--font-greek); font-size: 1.05rem; color: var(--text); }
.cmp-pair-cnt {
  font-family: var(--font-meta); font-size: .64rem;
  letter-spacing: .1em; text-transform: uppercase;
  color: var(--text-faint); margin-left: auto;
}
/* ---------- toposz clusters: formulaic duplicates folded into one row ------ */
.cmp-cluster { border-bottom: 1px solid var(--rule-strong); }
.cmp-cluster > details > summary { list-style: none; cursor: pointer; }
.cmp-cluster > details > summary::-webkit-details-marker { display: none; }
.cmp-cluster-head {
  display: flex; gap: .9rem; align-items: baseline; flex-wrap: wrap;
  padding: 1.1rem 0;
}
.cmp-cluster-head::before {
  content: "▸"; font-family: var(--font-meta); font-size: .7rem;
  color: var(--text-faint);
}
.cmp-cluster > details[open] > summary.cmp-cluster-head::before { content: "▾"; }
.cmp-cluster-head:hover .cmp-cluster-core { color: var(--accent); }
.cmp-cluster-count {
  font-family: var(--font-meta); font-size: .66rem;
  letter-spacing: .06em; font-variant-numeric: tabular-nums;
  color: var(--accent); border: 1px solid var(--accent);
  padding: .1rem .45rem; border-radius: var(--radius);
}
.cmp-cluster-core {
  font-family: var(--font-greek); font-size: 1.05rem; color: var(--text);
  min-width: 0; flex: 1 1 14rem;
}
.cmp-cluster-meta {
  font-family: var(--font-meta); font-size: .62rem;
  letter-spacing: .1em; text-transform: uppercase;
  color: var(--text-faint); margin-left: auto;
  font-variant-numeric: tabular-nums;
}
.cmp-cluster-refs {
  font-family: var(--font-meta); font-size: .66rem; line-height: 1.8;
  color: var(--text-soft); padding: 0 0 .9rem .35rem;
}
.cmp-cluster-refs .apparatus { color: var(--text-faint); margin-right: .4rem; }
.cmp-ref-more { color: var(--accent); }
.cmp-cluster-body {
  border-left: 1px solid var(--rule);
  margin: 0 0 1.2rem .35rem; padding-left: 1.4rem;
}
.cmp-cluster-body > .cmp-pair:last-child { border-bottom: none; }
.cmp-cluster-rest > summary {
  font-family: var(--font-meta); font-size: .64rem;
  letter-spacing: .08em; text-transform: uppercase;
  color: var(--text-faint); cursor: pointer; padding: .8rem 0;
  list-style: none;
}
.cmp-cluster-rest > summary::-webkit-details-marker { display: none; }
.cmp-cluster-rest > summary::before { content: "+ "; color: var(--accent); }
.cmp-cluster-rest[open] > summary::before { content: "− "; }
.cmp-cluster-rest > .cmp-pair:last-child { border-bottom: none; }
.cmp-info .warn { color: var(--accent); }

.cmp-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
.cmp-col { min-width: 0; }
.cmp-col-title {
  font-family: var(--font-meta); font-size: .62rem; font-weight: 400;
  letter-spacing: .14em; text-transform: uppercase;
  color: var(--text-faint);
  margin-bottom: .6rem; padding-bottom: .3rem;
  border-bottom: 1px solid var(--rule);
}
.cmp-text {
  font-family: var(--font-greek); font-size: .98rem; line-height: 1.9;
  color: var(--text); word-spacing: .1em;
  max-height: 24rem; overflow: auto;
}
/* verbatim reuse — the green */
.cmp-hl {
  background: var(--match-bg); color: var(--match);
  border-radius: var(--radius);
  padding: .02rem .16rem; cursor: pointer;
}
.cmp-hl:hover { background: var(--match); color: var(--bg-elev); }
.cmp-hl.cmp-active {
  background: var(--accent); color: var(--bg-elev);
  box-shadow: inset 0 0 0 1px var(--accent-soft);
}
/* morphological bridge — the ochre */
.dynamic-bridge-word { color: var(--text-faint); transition: color .1s, background .1s; }
.dynamic-bridge-word.is-similar {
  color: var(--bridge); background: var(--bridge-bg);
  border-radius: var(--radius); padding: .02rem .12rem;
}
.dynamic-bridge-word.is-dissimilar { opacity: .3; }
.cmp-ellipsis { color: var(--text-faint); font-family: var(--font-meta); }
.cmp-mode { color: var(--match); }
.cmp-note { font-family: var(--font-meta); font-size: .68rem; color: var(--text-faint); margin: .3rem 0 1rem; line-height: 1.6; }
.cmp-note b { color: var(--accent); font-weight: 400; }
#cmp-export { margin-left: .6rem; }
.legend {
  font-family: var(--font-meta); font-size: .64rem;
  letter-spacing: .08em; text-transform: uppercase; color: var(--text-faint);
}

/* ---- pickers ---- */
.cmp-pickers { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 1.2rem; }
.picker { position: relative; display: flex; flex-direction: column; gap: .5rem; }
.picker-author, .picker-work {
  font-family: var(--font-greek); font-size: .95rem;
  padding: .5rem .6rem;
  border: 1px solid var(--rule); border-radius: var(--radius);
  background: var(--bg-elev); color: var(--text);
}
.picker-author:focus, .picker-work:focus { outline: none; border-color: var(--accent); }
.picker-work:disabled { opacity: .5; }
.picker-suggest {
  display: none; position: absolute; top: 2.5rem; left: 0; right: 0; z-index: 30;
  background: var(--bg-elev); border: 1px solid var(--rule-strong);
  border-radius: var(--radius);
  max-height: 16rem; overflow: auto;
}
.picker-opt {
  padding: .45rem .7rem; cursor: pointer;
  font-family: var(--font-greek); font-size: .9rem;
  border-bottom: 1px solid var(--rule);
  display: flex; gap: .5rem; align-items: baseline; flex-wrap: wrap;
}
.picker-opt:hover { background: var(--bg-soft); }
.picker-gr { color: var(--accent); font-size: .82rem; }
.picker-id {
  margin-left: auto; font-family: var(--font-meta); font-size: .62rem;
  letter-spacing: .06em; color: var(--text-faint);
}
.flame-btn {
  flex: 0 0 auto; align-self: center;
  font-family: var(--font-meta); font-size: .68rem;
  letter-spacing: .1em; text-transform: uppercase;
  border: 1px solid var(--rule); background: none; color: var(--text-faint);
  border-radius: var(--radius); padding: .2rem .45rem; cursor: pointer;
  transition: color .12s, border-color .12s;
}
.flame-btn:hover { color: var(--match); border-color: var(--match); }

/* ---- streaming progress ---- */
.cmp-progress { display: flex; align-items: center; gap: .8rem; margin: .8rem 0 1.2rem; }
.cmp-progress.is-done .cmp-hourglass { animation: none; opacity: .35; }
.cmp-hourglass {
  font-size: 1rem; line-height: 1; color: var(--text-faint);
  animation: cmp-spin 1.4s linear infinite;
}
@keyframes cmp-spin { to { transform: rotate(360deg); } }
.cmp-bar {
  position: relative; flex: 1; height: 2px;
  background: var(--rule); overflow: hidden;
}
.cmp-bar-fill {
  position: absolute; left: 0; top: 0; bottom: 0; width: 0;
  background: var(--accent);
  transition: width .2s ease;
}
.cmp-bar-fill.indeterminate { width: 35% !important; animation: cmp-indet 1.1s ease-in-out infinite; }
@keyframes cmp-indet { 0% { left: -35%; } 100% { left: 100%; } }
.cmp-status {
  font-family: var(--font-meta); font-size: .66rem;
  letter-spacing: .08em; text-transform: uppercase;
  color: var(--text-faint); white-space: nowrap;
  font-variant-numeric: tabular-nums;
}
.cmp-recompute.is-dirty {
  color: var(--bridge); border-color: var(--bridge);
}

/* ---------- Archaism detector (#/archaism) ----------
   The same apparatus voice as the compare view: hairlines, small-caps metas,
   tabular figures. It reads as a critical apparatus, not a dashboard. */
.picker-col { flex: 1 1 16rem; min-width: 14rem; }
.picker-cap {
  font-family: var(--font-meta); font-size: .68rem;
  letter-spacing: .08em; text-transform: uppercase;
  color: var(--text-faint); margin-bottom: .35rem;
}
.arch-controls input[type=number] {
  font-family: var(--font-meta); font-size: .85rem; width: 3.6rem;
  padding: .25rem .35rem; text-align: right;
  border: 1px solid var(--rule); border-radius: var(--radius);
  background: var(--bg-elev); color: var(--text);
}
.arch-controls input[type=number]:focus { outline: none; border-color: var(--accent); }
.arch-table {
  width: 100%; border-collapse: collapse; font-size: .84rem;
  font-variant-numeric: tabular-nums;
}
.arch-table th {
  font-family: var(--font-meta); font-size: .66rem; font-weight: 400;
  letter-spacing: .08em; text-transform: uppercase; color: var(--text-faint);
  text-align: left; padding: .35rem .5rem; white-space: nowrap;
  border-bottom: 1px solid var(--rule);
}
.arch-table td {
  padding: .3rem .5rem; border-bottom: 1px solid var(--rule);
  color: var(--text-soft);
}
/* The word itself is the finding's subject — give it the text colour and let
   the numbers recede. */
.arch-table td.arch-word { color: var(--text); font-size: .95rem; }
.arch-table .num { text-align: right; white-space: nowrap; }
.arch-table .num.strong { color: var(--accent); }
.arch-table .arch-where {
  font-family: var(--font-meta); font-size: .72rem; color: var(--text-faint);
}
/* .muted/.warn are scoped to .cmp-info above and do not reach the table. */
.arch-table .muted { color: var(--text-faint); }
.arch-table tbody tr:hover { background: var(--bg-elev); }
/* The spelling split under a pooled word. Deliberately quiet: it is a footnote
   to a correct number, not a second finding. A/B order matches the table. */
.arch-vsplit {
  font-family: var(--font-meta); font-size: .68rem; line-height: 1.5;
  color: var(--text-faint); margin-top: .1rem; white-space: normal;
}
.arch-vsplit .muted { color: var(--text-faint); }
.arch-vsplit .marked { color: var(--text-soft); font-style: italic; }
/* The proper-noun toggle and the pooling row sit above the form, not inside it:
   they are inputs to the same request but read as a different kind of choice. */
.arch-variants { align-items: baseline; gap: .8rem; flex-wrap: wrap; }
.arch-variants .picker-cap { margin-bottom: 0; }
.arch-variants .muted {
  flex: 1 1 18rem; font-size: .76rem; line-height: 1.5;
  color: var(--text-faint); max-width: 42rem;
}
/* Style-register report: the direction column is prose, not a number, so it
   gets room to breathe and does not push the numeric columns around. */
.arch-table .arch-where.arch-dir { white-space: normal; min-width: 12rem; }
.arch-notes { margin-top: .9rem; }
.arch-note {
  font-size: .78rem; line-height: 1.6; padding: .5rem .6rem;
  border-left: 2px solid var(--rule); margin-bottom: .4rem;
  color: var(--text-soft);
}
.arch-note .muted { color: var(--text-faint); }
.arch-note .warn { color: var(--text-soft); font-style: italic; }
/* `.arch-lex-only` is hidden by _archSyncMode in style mode; the wrapper must
   not collapse the control row's spacing when it is showing. */
.arch-lex-only { display: contents; }
.arch-koine-only { display: contents; }

/* ---- three-corpus report: class badges, census, marked-in-B tags ---- */
/* The class is the report's actual output, so it is a badge and not a colour on
   the row: the reader sorts the table by looking at one column, and the census
   above it is the same five words with counts, which is what makes the class
   mix readable at a glance. */
.arch-class {
  display: inline-block; padding: .05rem .4rem; border-radius: 999px;
  font-size: .72rem; letter-spacing: .02em; white-space: nowrap;
  border: 1px solid var(--rule); color: var(--text-soft); background: transparent;
}
.arch-class b { font-weight: 600; }
.arch-class-archaism { border-color: var(--accent); color: var(--accent); }
.arch-class-classical { color: var(--text); }
.arch-class-overused { border-style: dashed; }
.arch-class-avoided { border-style: dotted; color: var(--text-faint); }
.arch-class-shared { color: var(--text-faint); border-color: transparent; }
.arch-census { margin: .6rem 0 1rem; line-height: 2.1; }
.arch-census .picker-cap { color: var(--text-faint); }
.arch-refnote {
  font-size: .8rem; line-height: 1.6; padding: .5rem .6rem; margin: .5rem 0 0;
  border-left: 2px solid var(--rule); color: var(--text-soft);
}
.arch-refnote .muted { color: var(--text-faint); }
.arch-table td.arch-mark { white-space: normal; min-width: 5rem; }
.arch-tag {
  display: inline-block; padding: 0 .3rem; margin-right: .2rem;
  border: 1px solid var(--rule); border-radius: var(--radius);
  font-size: .7rem; color: var(--text-soft);
}
/* 13 columns: without this the rate columns wrap and the table stops being
   scannable as a grid, which is the only way to read three rates at once. */
.arch-table-koine { font-size: .78rem; }
.arch-table-koine td, .arch-table-koine th { padding-left: .4rem; padding-right: .4rem; }
.arch-table-koine .num { font-variant-numeric: tabular-nums; }

/* ---- evidence panel (KWIC / parallels / n-grams) ---- */
.arch-evidence:empty { display: none; }
.arch-evidence {
  margin-top: 1.2rem; padding: .9rem 1rem;
  border: 1px solid var(--rule); border-radius: var(--radius);
  background: var(--bg-elev);
}
/* The word cell is the control. Underlined on hover so the affordance is
   discoverable without a permanent underline that would read as a link out. */
.arch-table td[data-arch-word],
.arch-table td[data-arch-rule] { cursor: pointer; }
.arch-table td[data-arch-word]:hover,
.arch-table td[data-arch-rule]:hover { text-decoration: underline dotted; }
/* The lemma row opens its own inflectional breakdown. The whole row is the
   control because the row IS the claim — the headword, its count and its form
   spread are one statement, and the breakdown answers all three at once. */
.arch-table tr[data-lemma-toggle] { cursor: pointer; }
.arch-table tr[data-lemma-toggle]:hover .arch-word { text-decoration: underline dotted; }
.arch-table tr.lemma-forms > td { padding: .3rem .6rem .7rem; }
.arch-table tr.lemma-forms .arch-vsplit > div { padding: .1rem 0; }
.arch-table tr.lemma-forms .arch-vsplit b { margin-left: .4rem; }
.ev-head {
  display: flex; align-items: baseline; gap: .7rem; flex-wrap: wrap;
  margin-bottom: .5rem;
}
.ev-head .greek { font-size: 1.05rem; }
.ev-head .muted { color: var(--text-faint); font-size: .78rem; flex: 1 1 auto; }
.ev-close {
  font-family: var(--font-meta); font-size: .7rem; letter-spacing: .06em;
  text-transform: uppercase; background: none; color: var(--text-faint);
  border: 1px solid var(--rule); border-radius: var(--radius);
  padding: .15rem .45rem; cursor: pointer;
}
.ev-close:hover { color: var(--text); border-color: var(--text-faint); }
.ev-cap {
  font-family: var(--font-meta); font-size: .68rem; letter-spacing: .06em;
  text-transform: uppercase; color: var(--text-faint); margin: .7rem 0 .3rem;
}
.ev-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.ev-kwic, .ev-parallel { list-style: none; margin: 0; padding: 0; }
.ev-kwic li, .ev-parallel li {
  font-size: .84rem; line-height: 1.65; padding: .2rem 0;
  border-bottom: 1px solid var(--rule); display: flex; gap: .5rem;
  align-items: baseline; flex-wrap: wrap;
}
.ev-locus {
  font-family: var(--font-meta); font-size: .7rem; color: var(--text-faint);
  white-space: nowrap; min-width: 4.4rem;
}
.ev-context { flex: 1 1 14rem; color: var(--text-soft); }
/* The marked spelling is the evidence for the register claim; it is marked by a
   subdued background, not a colour, so it survives a monochrome print. */
.ev-context mark, .ev-parallel mark {
  background: color-mix(in srgb, var(--accent) 22%, transparent);
  color: var(--text); padding: 0 .1em; border-radius: 2px;
}
.ev-mini {
  font-family: var(--font-meta); font-size: .66rem; color: var(--text-faint);
  background: none; border: 1px solid var(--rule); border-radius: var(--radius);
  padding: .1rem .35rem; cursor: pointer; white-space: nowrap;
}
.ev-mini:hover { color: var(--text); border-color: var(--text-faint); }
.ev-score {
  font-family: var(--font-meta); font-size: .7rem; color: var(--accent);
  font-variant-numeric: tabular-nums; white-space: nowrap;
}
.ev-shared {
  flex: 1 1 100%; font-size: .74rem; color: var(--text-faint);
  padding-left: 4.9rem;
}
.ev-shared b { color: var(--text-soft); font-weight: 400; }
.ev-note { font-size: .74rem; line-height: 1.6; margin-top: .6rem; }
.ev-note .muted, .ev-note.muted { color: var(--text-faint); }
.ev-actions {
  display: flex; gap: .6rem; flex-wrap: wrap; align-items: baseline;
  margin-top: .7rem;
}
.ev-actions input[type=number] {
  font-family: var(--font-meta); font-size: .8rem; width: 3.2rem;
  padding: .2rem .3rem; text-align: right;
  border: 1px solid var(--rule); border-radius: var(--radius);
  background: var(--bg); color: var(--text);
}
@media (max-width: 760px) {
  .ev-cols { grid-template-columns: 1fr; }
  .ev-shared { padding-left: 0; }
}

/* ---- responsive ---- */
@media (max-width: 760px) {
  .reader { grid-template-columns: 1fr; gap: 1.6rem; }
  .reader-nav {
    position: static; max-height: none; margin-bottom: 1rem;
    border-right: none; border-bottom: 1px solid var(--rule);
    padding-right: 0; padding-bottom: .8rem;
  }
  .result { grid-template-columns: 3rem 1fr; }
  .result .count { display: none; }
  main { padding: 1.4rem 1rem 3rem; }
  .topbar { padding: .8rem 1rem .7rem; gap: .8rem; }
  .top-nav { gap: 1rem; }
  .author-name { font-size: 1.6rem; }
  .cmp-cols { grid-template-columns: 1fr; gap: 1.4rem; }
  .cmp-pickers { grid-template-columns: 1fr; gap: 1.2rem; }
  .search-wrap { max-width: none; }
}

/* Very narrow: the masthead keeps the wordmark and the nav, drops nothing
   essential — the apparatus controls stay reachable below. */
@media (max-width: 480px) {
  .brand { letter-spacing: .22em; margin-right: -.22em; }
  .top-nav a { letter-spacing: .08em; }
  .icon-btn { font-size: .68rem; padding: .2rem .25rem; }
}
