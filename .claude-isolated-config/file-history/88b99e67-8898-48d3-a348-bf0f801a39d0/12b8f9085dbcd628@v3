# ═════════════════════════════════════════════════════════════════════
#  .claudesignore — Kizárási lista + Repótérkép (két az egyben)
# ═════════════════════════════════════════════════════════════════════
# HASZNÁLATI UTASÍTÁS:
# Ha kérdésed van a repóról, először ezt a fájlt érdemes megnézni –
# minden lényeges információ itt van egy helyen, find-ozás nélkül.
# Ha betöltesz egy új fájlt a repóba, módosítsd ezt a fájlt is
# (forráskód -> 1. szekció, adat -> 2-3. szekció,
#  új adatmappa -> 4. szekció + exclusion rule)!
#
# Formátum:
#   # komment = repótérkép (leírás)
#   nem-komment sor = kizárási szabály (.gitignore stílusban)
# ═════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────────
# 1. SZEKCIÓ — Forráskódok
# ────────────────────────────────────────────────────────────────────
# app/ — Alkalmazás core modulok (Flame kereső + TEI parser + BPE)
#   bpe_pure.py        — Tiszta Python BPE tokenizer (byte-pair encoding)
#   archaism_pure.py   — Archaizmus-detektor: lexikai ritkaság + stílusregiszter
#   canon.py           — Kánon adatmodell (canon.csv betöltése, keresés)
#   flame_pure.py      — Flame: keresőmotor (BOW, TF-IDF, n-gram)
#   hopper.py          — Hopper: windows-based token hopping elemzés
#   lemmas_pure.py     — Lematizálás: zárt osztály + toldalék-szabályok + korpusz-resolver,
#                        inflexiós aggregáció (ὁπλίτας/ὁπλῖται/ὁπλιτῶν → ὁπλίτης)
#   loci_pure.py       — KWIC + párhuzamos locus-keresés + 2-/3-gram frazeológia
#   repo.py            — Repository réteg (data réteg absztrakció)
#   server.py          — Flask web szerver (UI végpontok)
#   sources.py         — Források kezelése (TLG / CTS / BCD)
#   tei.py             — TEI/XML parser (ókori görög szövegekhez)
#   texts.py           — Szövegkezelő réteg (lekérés, cache, meta)
#   variants.py        — Variáns-összevonás + stílusregiszter (ξυ/συ, γιγν/γιν, ττ/σσ)
#   __init__.py        — Package init
#   static/
#     app.js           — Frontend JS (Flame kereső UI)
#     index.html       — Főoldal
#     styles.css       — Stíluslap
#     *.bak.*          — BACKUP (kizárva)
#   *.bak.*            — BACKUP (kizárva)
#
# scripts/ — ETL és építő scriptek (24 Python fájl)
#   apply_supplement.py       — Supplement JSON alkalmazása a kánonra
#   build_bpe.py              — BPE szótár építése a korpuszból
#   build_canon.py            — Kánon CSV összeállítása forrásokból
#   build_gaps_report.py      — Hiányjelentés generálása
#   build_jsonld.py           — JSON-LD kimenet előállítása
#   build_repo_map.py         — Repó térkép generálása
#   check_no_restricted.py    — Restricted adatok ellenőrzése
#   common.py                 — Közös segédfüggvények
#   enrich_canon.py           — Kánon bővítése külső adatokkal
#   export_diogenes.py        — Diogenes export formátumba alakítás
#   fetch_sources.py          — Külső források letöltése
#   htmlutil.py               — HTML feldolgozó segédfüggvények
#   parse_bcdavasconcelos.py  — BCDA Vasconcelos lista parse
#   parse_cts.py              — CTS katalógus parse
#   parse_tlg_cd.py           — TLG CD (Canonical Date) parse
#   parse_tlg_post.py         — TLG Post adatok parse
#   serve.py                  — Fejlesztői szerver indítás
#   validate_canon.py         — Kánon validálás
#   wikidata.py               — Wikidata API lekérdezések
#
# schema/ — JSON Schema definíciók
#   canon.schema.json         — Kánon JSON Schema
#   context.jsonld            — JSON-LD kontextus
#
# reports/ — Építési és elemzési riportok (Markdown)
#   build_report.md           — Build státusz riport
#   gaps_report.md            — Hiányosság riport
#
# docs/ — Dokumentáció (Markdown)
#   CONTRIBUTING.md           — Hozzájárulási útmutató
#   latin-feasibility.md      — Latin szövegek támogatásának elemzése
#   viaf-coverage.md          — VIAF lefedettségi elemzés
#
# sideproject/procopius_reuse/ — Mellékprojekt: Procopius újrafelhasználás elemzés
#   scripts/
#     extract_apparatus_citations.py  — Lábjegyzet-idézetek kinyerése
#   tei/                              — TEI XML összehasonlító anyag (3 szerző)
#

# ────────────────────────────────────────────────────────────────────
# 2. SZEKCIÓ — Adatfájlok (gyökér szinten)
# ────────────────────────────────────────────────────────────────────
# data/bpe_vocab.json         — BPE szótár (60K) — tokenizer vocabulary
# data/canon.csv              — Kánon CSV (1.6M) — fő kánon tábla
# data/canon.json             — Kánon JSON (3.6M) — strukturált kánon
# data/canon.jsonld           — Kánon JSON-LD (4.1M) — linked data verzió
# data/canon-editions.nt      — Kiadások NT triples (332K)
# data/canon-links.nt         — Kapcsolatok NT triples (992K)
# data/diogenes_canon.csv     — Diogenes export CSV (1012K)
# data/diogenes.sqlite        — Diogenes SQLite (1.7M) — bináris
#
# data/local/supplement.json  — Helyi kiegészítések (4K)
#
# data/intermediate/ — Feldolgozás köztes állapotai
#   authors_classic.json      — Klasszikus szerzők listája
#   authors_poste.json        — Post-klasszikus szerzők listája
#   bcd_works.json            — BCDA művek listája
#   cts_index.json            — CTS index
#   greekLit_map.json         — GreekLit URN mapping
#   wikidata_era.json         — Wikidata korszak adatok
#   sources/ — 48 db kis JSON forrásrekord (4-8K each)

# ────────────────────────────────────────────────────────────────────
# 3. SZEKCIÓ — Korpuszok / Szöveggyűjtemények
# ────────────────────────────────────────────────────────────────────
# data/texts/ — Ókori görög TEI/JSON szövegkorpusz (31M összesen)
#   ~30 szerzői mappa, 43 fájl (TEI XML + JSON formátumban)
#   Legnagyobbak: tlg0008 (4.7M), tlg4029 (4.2M), tlg4031 (3.2M), tlg0012 (3.5M)
#   Forrás: Perseus / CTS (CC BY-SA)
#
# data/raw/ — Letöltött nyers forrásadatok (9M)
#   cd.authors.html       (116K)  — TLG CD authors oldal
#   cts_capabilities.xml  (2.8M)  — CTS képességek XML
#   main_list.md          (4.5M)  — Fő lista (nagy!)
#   post_tlg_e.html       (1.7M)  — TLG Post lista

# ────────────────────────────────────────────────────────────────────
# 4. SZEKCIÓ — Kizárt mappák és token-nyelők (Exclusion Rules)
# ────────────────────────────────────────────────────────────────────
# data/raw/main_list.md        — (4.5M) nagy nyers lista
# data/raw/cts_capabilities.xml — (2.8M) nagy XML
# data/raw/cd.authors.html     — (116K) HTML forrás
# data/raw/post_tlg_e.html     — (1.7M) HTML forrás
# data/texts/                   — (31M) TEI/JSON szövegkorpusz (CC BY-SA)
# data/intermediate/sources/   — ~48 db JSON forrásrekord
# data/canon.csv / canon.json  — (1.6M / 3.6M) kánon adatok
# data/diogenes.sqlite         — (1.7M) bináris adatbázis
# data/canon-editions.nt       — (332K) NT triples
# data/canon-links.nt          — (992K) NT triples
# data/diogenes_canon.csv      — (1012K) CSV export
# data/bpe_vocab.json          — (60K) BPE szótár
# sideproject/procopius_reuse/raw_pdfs/ — (126M) PDF fájlok
# sideproject/procopius_reuse/.cache_pdftotext/ — (7.5M) szöveggyorsítótár
# __pycache__/                 — Python bytecode cache
# *.log                        — Log fájlok
# *.bak / *.bak.*              — Backup fájlok
# koine.gif / koni_example.png — (372K / 280K) képek

# Exclusion rules (gitignore stílusban)
data/raw/*
data/texts/*
data/intermediate/sources/*
data/intermediate/*.json
data/canon.csv
data/canon.json
data/canon.jsonld
data/diogenes.sqlite
data/diogenes_canon.csv
data/canon-editions.nt
data/canon-links.nt
data/bpe_vocab.json
data/local/*
!data/.gitkeep
sideproject/procopius_reuse/raw_pdfs/*
sideproject/procopius_reuse/.cache_pdftotext/*
__pycache__/
*.bak*
*.bak.*
*.log
koine.gif
koni_example.png

