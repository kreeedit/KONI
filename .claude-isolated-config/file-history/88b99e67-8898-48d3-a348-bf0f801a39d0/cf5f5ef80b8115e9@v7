  }
  const p1 = makePicker(document.getElementById("picker1"), "1. search author (e.g. Procopius, 4029, Ὅμηρος)");
  const p2 = makePicker(document.getElementById("picker2"), "2. search author");
  _cmpState = { ...CMP_DEFAULTS, p1, p2 };
  // Pre-fill from ?first=AID.WORK (e.g. a Flame button on the author page).
  if (q.first) {
    const m = q.first.match(/^(\d{1,4})\.(\d{3})$/);
    if (m) { p1.selectAuthor(m[1].padStart(4, "0")).then(() => p1.setWork(m[2])); }
  }
  document.getElementById("cmp-go").addEventListener("click", runCompare);
}

/* ---------- Archaism detector (#/archaism) ----------
   A DIFFERENT QUESTION from the Flame view. Flame asks "did this passage
   recur?"; this asks "did this word's RATE collapse from the earlier work to
   the younger one?". Work-level, not passage-level, and the rows are
   candidates to inspect, never findings — the same rate collapse is produced
   by a real archaism, a quotation, a technical term, a proper noun and plain
   noise, and no bag of word counts can tell those apart. The UI says so. */
const ARCH_DEFAULTS = { min_a: 3, min_b: 1, max_b: 1, min_score: 2.0, drop_proper: true };
// Engine rule identifiers. The NAMES have to be known here to build the toggles
// before the first response arrives; everything else about a rule — its label,
// what it means, the measured evidence — comes back in `variants_available` and
// is what the UI actually displays. If the engine grows or drops a rule, the
// first response reconciles this list instead of the UI quietly offering a
// toggle that does nothing.
let ARCH_VARIANTS = ["xyn", "gign", "tt", "rr"];
let _archState = null;

function _archMode(q) {
  const m = (q && q.mode) || "lexical";
  return m === "style" ? "style" : "lexical";
}

async function renderArchaism(q) {
  q = q || {};
  const mode = _archMode(q);
  const sel = (q.variants || "").trim();
  const chosen = sel === "" ? ARCH_VARIANTS.slice()
    : sel === "none" ? [] : sel.split(",").filter((x) => ARCH_VARIANTS.includes(x));
  $view().innerHTML = `
    <h1 class="page-title">Archaism · two reports</h1>
    <p class="page-intro">
    <strong>Lexical rarity</strong> ranks words by how far their rate dropped
    from the earlier work to the younger one. It is the honest name for what a
    word count can measure: a word that surfaces once or twice in the younger
    work after being common in the earlier one. The same collapse is produced by
    a real archaism, an allusion, a technical or religious term and by topic
    shift — Thucydides' subject is the Peloponnesian War and Procopius' is
    Justinian's, so the unfiltered top rows are all ethnics and toponyms. Rows
    are <strong>candidates to inspect, not findings</strong>.
    <br><br>
    <strong>Style register</strong> asks a different question: not <em>which
    words</em> recur, but <em>which spelling the author chose</em>. Attic
    ξυμμαχία against Koine συμμαχία, γιγν- against γιν-, -ττ- against -σσ-. The
    rate of the marked spelling per 1000 words is a register metric that does not
    move with topic or with vocabulary attrition, because it compares spelling
    <em>choices</em> on whatever words each author uses anyway. Measured
    Thucydides → Procopius, the three correspondences run in <em>three different
    directions</em>: ξυ- at parity (12.79 vs 12.85 per 1k — systemic imitation
    that a rarity filter cannot see, since nothing is rare), γιγν- collapsed 20×,
    and -ττ- in <em>excess</em> in the younger work (0.07 → 0.49), because -ττ-
    is the 2nd-c. AD Atticist restoration rather than a Thucydidean trait.
    <br><br>
    That last point is why the ratios cannot yet be read as verdicts: whether a
    parity or an excess is the archaizing choice is a fact about the period's
    norm, and it needs a <strong>third, contemporary reference corpus</strong> —
    a work of the younger author's own time that is not itself classicizing.
    Without it these are ratios to inspect, not a classification.
    </p>
    <div class="cmp-pickers">
      <div class="picker-col"><div class="picker-cap">earlier work (A)</div>
        <div class="picker" id="apicker1"></div></div>
      <div class="picker-col"><div class="picker-cap">younger work (B)</div>
        <div class="picker" id="apicker2"></div></div>
    </div>
    <div class="cmp-controls arch-controls">
      <label class="live-toggle">Report:
        <select id="arch-mode">
          <option value="lexical"${mode === "lexical" ? " selected" : ""}>Lexical rarity</option>
          <option value="style"${mode === "style" ? " selected" : ""}>Style register</option>
        </select></label>
      <span class="arch-lex-only">
        <label>min. count in A: <input type="number" id="arch-mina" min="1" value="${ARCH_DEFAULTS.min_a}"></label>
        <label>min. count in B: <input type="number" id="arch-minb" min="0" value="${ARCH_DEFAULTS.min_b}"></label>
        <label>max. count in B: <input type="number" id="arch-maxb" min="0" value="${ARCH_DEFAULTS.max_b}"></label>
        <label class="live">min. collapse (log2): <input type="range" id="arch-score" min="0" max="10" step="0.5" value="${ARCH_DEFAULTS.min_score}"><span id="arch-score-val" class="slider-val">${ARCH_DEFAULTS.min_score.toFixed(1)}</span></label>
      </span>
      <label class="live-toggle">Drop proper nouns: <input type="checkbox" id="arch-prop" checked></label>
    </div>
    <div class="cmp-controls arch-controls arch-variants">
      <span class="picker-cap">pool variant spellings</span>
      ${ARCH_VARIANTS.map((n) => `<label class="live-toggle" title="${esc(_archVariantLabel(n))}"
        ><input type="checkbox" class="arch-var" value="${n}"${chosen.includes(n) ? " checked" : ""}> ${esc(n)}</label>`).join("")}
      <span class="muted">Pooling folds a classical spelling onto the Koine one so
      both add up in one row. It is a correctness fix, not a preference: without
      it ἐγίγνετο reads as a 45 → 1 collapse, when Procopius simply writes
      ἐγίνετο 53 times.</span>
    </div>
    <div class="cmp-form"><button id="arch-go" class="more-btn">Compare</button></div>
    <div id="arch-results"></div>`;
  _archSyncMode();
  if (!ALL_AUTHORS) {
    try { ALL_AUTHORS = await fetchJSON(API("/authors?q=&limit=100000")); }
    catch { /* will be lazily loaded by picker */ }
  }
  const p1 = makePicker(document.getElementById("apicker1"), "earlier work — search author");
  const p2 = makePicker(document.getElementById("apicker2"), "younger work — search author");
  _archState = { p1, p2 };
  if (q.first) {
    const m = q.first.match(/^(\d{1,4})\.(\d{3})$/);
    if (m) { p1.selectAuthor(m[1].padStart(4, "0")).then(() => p1.setWork(m[2])); }
  }
  document.getElementById("arch-score").addEventListener("input", (e) => {
    document.getElementById("arch-score-val").textContent = (+e.target.value).toFixed(1);
  });
  document.getElementById("arch-mode").addEventListener("change", _archSyncMode);
  document.getElementById("arch-go").addEventListener("click", runArchaism);
}

/* Rule descriptions come from the engine, not from this file. Before the first
   response there is nothing to describe, so the toggle shows the bare name. */
let _ARCH_RULES = null;
function _archVariantLabel(name) {
  const r = _ARCH_RULES && _ARCH_RULES.find((x) => x.name === name);
  if (!r) return name;
  return `${r.summary}\n${r.marked} is the marked spelling; key side ${r.key_side}.\n` +
         `Measured: ${r.evidence}` + (r.caveat ? `\nNote: ${r.caveat}` : "");
}

/* The engine may know rules this file does not. Reconcile once, so a toggle is
   never offered for something that does not exist, and a new rule is not
   silently unreachable. */
function _archReconcileRules(available) {
  if (!available || !available.length) return;
  _ARCH_RULES = available;
  const names = available.map((r) => r.name);
  if (names.join() === ARCH_VARIANTS.join()) return;
  console.warn("archaism: engine rule set differs from the UI list; reconciling",
               { ui: ARCH_VARIANTS, engine: names });
  ARCH_VARIANTS = names;
}

function _archSyncMode() {
  const m = document.getElementById("arch-mode");
  if (!m) return;
  const lex = m.value !== "style";
  document.querySelectorAll(".arch-lex-only").forEach((el) => {
    el.style.display = lex ? "" : "none";
  });
}

async function runArchaism() {
  const a = _archState.p1 && _archState.p1.value();
  const b = _archState.p2 && _archState.p2.value();
  if (!a || !b) { toast("Select both works (author + work)."); return; }
  const ma = a.match(/^(\d{1,4})\.(\d{3})$/), mb = b.match(/^(\d{1,4})\.(\d{3})$/);
  if (!ma || !mb) { toast("Invalid work id."); return; }
  const box = document.getElementById("arch-results");
  if (!box) return;
  const num = (id, dflt) => {
    const raw = document.getElementById(id).value.trim();
    const v = parseInt(raw, 10);
    return Number.isFinite(v) ? v : dflt;
  };
  const mode = (document.getElementById("arch-mode") || {}).value || "lexical";
  const checked = Array.from(document.querySelectorAll(".arch-var:checked"))
    .map((c) => c.value);
  const varParam = checked.length === ARCH_VARIANTS.length ? "all"
    : checked.length === 0 ? "none" : checked.join(",");
  const minA = Math.max(1, num("arch-mina", ARCH_DEFAULTS.min_a));
  const minB = Math.max(0, num("arch-minb", ARCH_DEFAULTS.min_b));
  const maxB = Math.max(0, num("arch-maxb", ARCH_DEFAULTS.max_b));
  const minScore = +document.getElementById("arch-score").value;
  const dropProper = document.getElementById("arch-prop").checked;
  box.innerHTML = `<div class="reader-empty">${mode === "style"
    ? "Counting marked spellings in both works…" : "Counting words in both works…"}</div>`;
  const url = API(`/archaism/${ma[1].padStart(4,"0")}/${ma[2]}/${mb[1].padStart(4,"0")}/${mb[2]}` +
    `?mode=${mode}&variants=${encodeURIComponent(varParam)}` +
    `&min_a=${minA}&min_b=${minB}&max_b=${maxB}&min_score=${minScore}&drop_proper=${dropProper ? 1 : 0}`);
  let d;
  try { d = await fetchJSON(url); }
  catch (e) { box.innerHTML = `<div class="reader-empty">Error: ${esc(String(e && e.message || e))}</div>`; return; }
  if (!box.isConnected) return;             // view changed while loading
  if (d.error) { box.innerHTML = `<div class="reader-empty">${esc(d.error)}</div>`; return; }
  _archReconcileRules(d.variants_available);
  box.innerHTML = d.mode === "style"
    ? _styleHtml(d, { dropProper })
    : _archHtml(d, { minA, minB, maxB, minScore, dropProper });
  _ARCH_CTX = { a1: ma[1].padStart(4, "0"), w1: ma[2],
                a2: mb[1].padStart(4, "0"), w2: mb[2], variants: varParam };
  _wireEvidence(box);
}

/* ---------- evidence panel: KWIC, parallel loci, n-gram phraseology ----------
   Point 5 of the critique. A row in either report is a CLAIM, and a claim whose
   evidence is one click away is checkable; one behind a separate page is not
   checked. Everything here reads the same `window=False` token stream the row's
   numbers came from, so a count and its loci cannot disagree. */
let _ARCH_CTX = null;

/* The pooled key is derived SERVER-SIDE from the displayed word, by the same
   function the count used. The client never pools anything itself: a second
   implementation of the correspondence rules in JavaScript is a second place
   for them to be wrong. */
function _evUrl(ctx, what, params) {
  const qs = new URLSearchParams(Object.assign({ variants: ctx.variants === "all"
    ? "all" : ctx.variants }, params));
  return API(`/${what}/${ctx.a1}/${ctx.w1}/${ctx.a2}/${ctx.w2}?${qs}`);
}

function _evPanel() { return document.getElementById("arch-evidence"); }

async function _evLoad(ctx, what, params, render) {
  const p = _evPanel();
  if (!p) return;
  p.innerHTML = `<div class="reader-empty">Loading…</div>`;
  let d;
  try { d = await fetchJSON(_evUrl(ctx, what, params)); }
  catch (e) {
    if (p.isConnected) p.innerHTML = `<div class="reader-empty">Error: ${esc(String(e && e.message || e))}</div>`;
    return;
  }
  if (!p.isConnected) return;         // view changed while loading
  if (d.error) { p.innerHTML = `<div class="reader-empty">${esc(d.error)}</div>`; return; }
  p.innerHTML = render(d);
  p.scrollIntoView({ block: "nearest", behavior: "smooth" });
}

function _evCtxLine(d, word) {
  // A rule panel is about a spelling CLASS, not a word, and saying so is the
  // difference between "ξυ is a word that occurs 1889 times" (nonsense) and
  // "1889 tokens are written with ξυ-" (the actual finding).
  const title = d.rule
    ? `<b>rule</b> <b class="greek">${esc(d.word)}</b>
       <span class="muted">· every token wearing the marked spelling</span>`
    : `<b class="greek">${esc(word)}</b>`;
  return `<div class="ev-head">${title}
    <span class="muted">A = ${esc(d.work1.title || d.work1.aid)},
    B = ${esc(d.work2.title || d.work2.aid)}</span>
    <button class="ev-close" type="button" data-ev-close="1">close</button></div>`;
}

function _evHits(side, key) {
  const hits = (side.hits || {})[key] || [];
  if (!hits.length) return `<div class="reader-empty">no occurrences</div>`;
  return `<ol class="ev-kwic">${hits.map((h) => `
    <li><span class="ev-locus">${esc(h.label)}:${h.index}</span>
      <span class="ev-context greek">${esc(h.before.join(" "))}
        <mark${h.marked && h.marked.length ? ` class="ev-marked" title="marked spelling: ${esc(h.marked.join(", "))}"` : ""}>${esc(h.hit)}</mark>
        ${esc(h.after.join(" "))}</span>
      <button class="ev-mini" type="button" data-ev-par="${esc(h.label)}:${h.index}"
        title="find the most similar sentences in A">‖ parallel</button></li>`).join("")}</ol>`;
}

function _evLociHtml(d, word) {
  const k = d.key;
  const ta = d.work_a.truncated[k], tb = d.work_b.truncated[k];
  return _evCtxLine(d, word) + `
    <div class="ev-cols">
      <div><div class="ev-cap">in A · ${d.work_a.n_hits[k] || 0} occurrence(s)${
        ta ? ` <span class="warn">(showing the first ${(d.work_a.hits[k] || []).length})</span>` : ""}</div>
        ${_evHits(d.work_a, k)}</div>
      <div><div class="ev-cap">in B · ${d.work_b.n_hits[k] || 0} occurrence(s)${
        tb ? ` <span class="warn">(showing the first ${(d.work_b.hits[k] || []).length})</span>` : ""}</div>
        ${_evHits(d.work_b, k)}</div>
    </div>
    <div class="ev-note muted">±${d.work_a.span} words. A <mark class="ev-marked">highlighted</mark>
    form wears the marked spelling — this is where the register question stops being a
    rate and becomes a text.</div>
    ${d.rule ? `<div class="ev-note muted">Phraseology is keyed on a word, and a rule
    is a class of spellings, not a word a phrase can be formed around — pick a word
    from the lexical report for that.</div>` : ""}
    <div class="ev-actions">
      ${d.rule ? "" : `<button class="more-btn" type="button" data-ev-ngram="2">2-gram phraseology</button>
      <button class="more-btn" type="button" data-ev-ngram="3">3-grams</button>`}
      <label class="live-toggle">min. count in A:
        <input type="number" id="ev-mina" min="1" value="3"></label>
      <label class="live-toggle">max. count in B:
        <input type="number" id="ev-maxb" min="0" value="0"></label>
    </div>`;
}

function _evNgramsHtml(d, word) {
  const rows = d.contrast.rows || [];
  const body = rows.map((x) => `
    <tr>
      <td class="arch-word greek">${esc((x.display || x.gram).join(" "))}</td>
      <td class="num">${x.count_a}</td>
      <td class="num">${x.count_b}</td>
      <td class="num">${x.rate_a.toFixed(3)}</td>
      <td class="num">${x.rate_b.toFixed(3)}</td>
      <td class="num strong">${x.score.toFixed(2)}</td>
    </tr>`).join("");
  const both = (d.table_a.total || 0) + (d.table_b.total || 0);
  return _evCtxLine(d, word) + `
    <div class="ev-cap">${d.n}-grams of which <b class="greek">${esc(word)}</b> is one member,
      collapsed from A to B${both ? "" : " — nothing to show"}</div>
    ${rows.length ? `<table class="arch-table">
      <thead><tr><th>phrase</th><th class="num">A ×</th><th class="num">B ×</th>
      <th class="num">A /1k</th><th class="num">B /1k</th><th class="num">collapse</th></tr></thead>
      <tbody>${body}</tbody></table>` : `<div class="reader-empty">No phrase of A's
      qualifies at these thresholds. A phrase A used once is noise, not phraseology —
      raise “min. count in A” only to see fewer, not more.</div>`}
    <div class="ev-note muted">Counted over pooled spellings, so A’s <span class="greek">ξυμμαχία</span>
    and B’s <span class="greek">συμμαχία</span> are the same phrase. The phrase column prints
    A’s spelling. Rates divide by the works’ word counts (${d.n_a.toLocaleString()} /
    ${d.n_b.toLocaleString()}), not by the table’s own sums.</div>
    <div class="ev-actions">
      <button class="more-btn" type="button" data-ev-ngram="${d.n === 2 ? 3 : 2}">
        switch to ${d.n === 2 ? "3" : "2"}-grams</button>
      <button class="more-btn" type="button" data-ev-loci="${esc(word)}">occurrences</button>
    </div>`;
}

function _evParallelHtml(d, word) {
  const r = d.result;
  const q = (d.query_words || []).join(" ");
  const body = (r.hits || []).map((h) => `
    <li><span class="ev-locus">${esc(h.label)}</span>
      <span class="greek">${esc(h.text)}</span>
      <span class="ev-score">${h.score.toFixed(3)}</span>
      ${(h.shared_3.length || h.shared_2.length) ? `<div class="ev-shared">shared:
        ${h.shared_3.map((g) => `<b class="greek">${esc(g)}</b>`).join(" ")}
        ${h.shared_2.map((g) => `<span class="greek">${esc(g)}</span>`).join(" ")}</div>` : ""}</li>`).join("");
  return _evCtxLine(d, word) + `
    <div class="ev-cap">in B: <span class="greek">${esc((d.anchor.before || []).join(" "))}
      <mark>${esc(d.anchor.hit || "")}</mark> ${esc((d.anchor.after || []).join(" "))}</span></div>
    <div class="ev-cap">the most similar sentences in A</div>
    ${body ? `<ol class="ev-parallel">${body}</ol>` : `<div class="reader-empty">No sentence
      of A shares a phrase with this window at the current bar. A shared word is not a
      shared phrase — that is what this bar is for.</div>`}
    <div class="ev-note muted">TF-IDF cosine over sentence bags, using the same engine
    (${esc("_idf / _tfidf / cosine")}) as the reuse search. ${r.n_scored.toLocaleString()}
    sentences scored, ${r.n_dropped} dropped for sharing fewer than the
    required n-grams${r.n_skipped_long ? `, ${r.n_skipped_long} skipped as over-long runs` : ""}.
    <span class="greek">${esc(q.slice(0, 120))}${q.length > 120 ? "…" : ""}</span></div>
    <div class="ev-actions">
      <button class="more-btn" type="button" data-ev-loci="${esc(word)}">occurrences</button>
    </div>`;
}

/* One delegated handler for the whole results box. The evidence panel is
   replaced wholesale on every load, so per-node listeners would have to be
   re-bound each time — and a listener bound to a node that is about to be
   replaced is exactly how a UI acquires clicks that fire twice. */
function _wireEvidence(box) {
  if (!box || box.dataset.evWired) return;
  box.dataset.evWired = "1";
  box.addEventListener("click", (e) => {
    const t = e.target;
    if (!t || !t.closest) return;
    const close = t.closest("[data-ev-close]");
    if (close) { const p = _evPanel(); if (p) p.innerHTML = ""; return; }
    if (!_ARCH_CTX) return;
    const rule = t.closest("[data-arch-rule]");
    if (rule) {
      _ARCH_EV_WORD = rule.dataset.archRule;
      _evLoad(_ARCH_CTX, "loci", { rule: _ARCH_EV_WORD, span: 6, per_key: 12 },
              (d) => _evLociHtml(d, _ARCH_EV_WORD));
      return;
    }
    const word = t.closest("[data-arch-word]");
    if (word) {
      _ARCH_EV_WORD = word.dataset.archWord;
      _evLoad(_ARCH_CTX, "loci", { word: _ARCH_EV_WORD, span: 6, per_key: 12 },
              (d) => _evLociHtml(d, _ARCH_EV_WORD));
      return;
    }
    const par = t.closest("[data-ev-par]");
    if (par) {
      const w = _ARCH_EV_WORD || "";
      const [label, idx] = par.dataset.evPar.split(":");
      _evLoad(_ARCH_CTX, "parallel",
              { word: w, label, index: idx, span: 10, n: 5, min_shared: 1 },
              (d) => _evParallelHtml(d, w));
      return;
    }
    const ng = t.closest("[data-ev-ngram]");
    if (ng) {
      const w = _ARCH_EV_WORD || "";
      const mina = document.getElementById("ev-mina");
      const maxb = document.getElementById("ev-maxb");
      _evLoad(_ARCH_CTX, "ngrams", {
        word: w, n: ng.dataset.evNgram,
        min_a: mina ? (parseInt(mina.value, 10) || 3) : 3,
        max_b: maxb ? (parseInt(maxb.value, 10) || 0) : 0,
      }, (d) => _evNgramsHtml(d, w));
      return;
    }
    const oc = t.closest("[data-ev-loci]");
    if (oc) {
      _ARCH_EV_WORD = oc.dataset.evLoci;
      _evLoad(_ARCH_CTX, "loci", { word: _ARCH_EV_WORD, span: 6, per_key: 12 },
              (d) => _evLociHtml(d, _ARCH_EV_WORD));
    }
  });
}
/* Which word the open panel is about. The parallel and n-gram buttons carry only
   their own parameters (a locus, a gram size), so the word has to come from
   somewhere — and re-deriving it from the DOM would be a guess. */
let _ARCH_EV_WORD = "";

/* Direction is a label, not a verdict — see the page intro. "parity" is the one
   a rarity filter is structurally blind to, and "excess" is the one it scores
   backwards, so they get their own words rather than a colour. */
const ARCH_DIRECTION = {
  parity: "parity — at the model author's own rate",
  collapse: "collapse — the younger work dropped it",
  excess: "excess — the younger work uses it MORE",
  "absent-in-B": "absent from the younger work",
};

function _styleHtml(d, opts) {
  const r = d.result, w1 = d.work1, w2 = d.work2;
  const rules = r.rules || [];
  const head = `
    <div class="cmp-info">
      <b>${esc(w1.title || w1.aid)}</b> <span class="muted">(A, ${r.n_a.toLocaleString()} words)</span>
      &nbsp;→&nbsp;
      <b>${esc(w2.title || w2.aid)}</b> <span class="muted">(B, ${r.n_b.toLocaleString()} words)</span>
      <br><span class="muted">marked spelling per 1000 words${opts && opts.dropProper
        ? ", proper nouns removed" : ""} · pooling: ${(r.params.variants || []).join(", ") || "off"}</span>
    </div>`;
  if (!rules.length) {
    return head + `<div class="reader-empty">No correspondences selected — tick at
      least one under “pool variant spellings”.</div>`;
  }
  const body = rules.map((x) => `
    <tr>
      <td class="arch-word" data-arch-rule="${esc(x.name)}" title="click to see every token wearing this spelling">${esc(x.marked)}</td>
      <td class="muted">${esc(x.key_side)}</td>
      <td class="num">${x.rate_a.toFixed(3)}</td>
      <td class="num">${x.rate_b.toFixed(3)}</td>
      <td class="num strong">${x.ratio_ab == null ? "—" : x.ratio_ab.toFixed(2)}</td>
      <td class="arch-where arch-dir">${esc(ARCH_DIRECTION[x.direction] || x.direction)}</td>
      <td class="num muted">${x.count_a.toLocaleString()} / ${x.count_b.toLocaleString()}</td>
    </tr>`).join("");
  const notes = rules.map((x) => `
    <div class="arch-note">
      <b>${esc(x.marked)}</b> <span class="muted">${esc(x.summary)}</span>
      <br><span class="muted">Measured: ${esc(x.evidence)}</span>
      ${x.caveat ? `<br><span class="warn">${esc(x.caveat)}</span>` : ""}
      ${(x.n_proper_a || x.n_proper_b) ? `<br><span class="muted">proper nouns dropped
        from this row: ${x.n_proper_a.toLocaleString()} in A, ${x.n_proper_b.toLocaleString()} in B</span>` : ""}
    </div>`).join("");
  return head + `
    <table class="arch-table">
      <thead><tr>
        <th>marked</th><th>key</th><th>A /1k</th><th>B /1k</th><th>A/B</th>
        <th>direction</th><th>tokens A / B</th>
      </tr></thead>
      <tbody>${body}</tbody>
    </table>
    <div class="arch-notes">${notes}</div>
    <div id="arch-evidence" class="arch-evidence"></div>
    <div class="cmp-info"><span class="muted">A rate ratio is not yet a verdict:
    whether parity or excess is the archaizing choice is a fact about the period's
    norm, and reading it needs a third, contemporary reference corpus that is not
    itself classicizing.</span></div>`;
}

function _archHtml(d, opts) {
  const r = d.result, w1 = d.work1, w2 = d.work2;
  const rows = r.rows || [];
  /* Every field the caption prints is defaulted, never taken on trust. This is
     the same drift that produced `cluster_threshold=undefined`: one call site
     built its options object a field short, and the template literal rendered
     the string "undefined" straight into the page. The values still come from
     ARCH_DEFAULTS — one source — so a missing field shows the real default
     instead of a hole. */
  const o = {
    minA: opts.minA ?? ARCH_DEFAULTS.min_a,
    minB: opts.minB ?? ARCH_DEFAULTS.min_b,
    maxB: opts.maxB ?? ARCH_DEFAULTS.max_b,
    minScore: opts.minScore ?? ARCH_DEFAULTS.min_score,
  };
  const head = `
    <div class="cmp-info">
      <b>${esc(w1.title || w1.aid)}</b> <span class="muted">(A, ${r.n_a.toLocaleString()} words)</span>
      &nbsp;→&nbsp;
      <b>${esc(w2.title || w2.aid)}</b> <span class="muted">(B, ${r.n_b.toLocaleString()} words)</span>
      <br><span class="muted">≥ ${o.minA}× in A, ${o.minB}–${o.maxB}× in B, collapse ≥ ${o.minScore.toFixed(1)} (log2)</span>
      ${r.n_dropped_proper ? `<br><span class="muted">${r.n_dropped_proper.toLocaleString()} proper nouns hidden (toggle above to show)</span>` : ""}
      ${(r.n_elided_a || r.n_elided_b) ? `<br><span class="muted">elision fragments excluded from the counts: ${r.n_elided_a.toLocaleString()} in A, ${r.n_elided_b.toLocaleString()} in B</span>` : ""}
      ${r.n_candidates > rows.length ? `<br><span class="warn">showing ${rows.length} of ${r.n_candidates.toLocaleString()} candidates</span>` : ""}
    </div>`;
  if (!rows.length) {
    // Distinguish "nothing matched" from "the limit cut everything". Telling
    // the user to loosen the thresholds in the second case would send them in
    // the wrong direction — the thresholds found plenty of candidates.
    const msg = r.n_candidates > 0
      ? `${r.n_candidates.toLocaleString()} candidates matched, but the row limit hid them all — raise it.`
      : `No candidates at these thresholds. Loosen “min. collapse”, raise “max. count in B”, or lower “min. count in B”.`;
    return head + `<div class="reader-empty">${esc(msg)}</div>`;
  }
  /* A row whose count is the sum of more than one spelling has to say so. The
     count is still correct — the pool is the point — but a reader comparing a
     single cell against a printed concordance will not find that many tokens of
     the shape in the word column unless the split is shown. */
  const split = (x) => !x.variants || !x.variants.length ? "" :
    `<div class="arch-vsplit">${x.variants.map((v) =>
      `<span class="${v.marked ? "marked" : "muted"}">${esc(v.form)} ${v.count_a}/${v.count_b}</span>`
    ).join(" · ")}</div>`;
  const body = rows.map((x) => `
    <tr>
      <td class="arch-word" data-arch-word="${esc(x.word)}" title="click for the occurrences">${esc(x.word)}${split(x)}</td>
      <td class="num">${x.count_a}</td>
      <td class="num">${x.rate_a.toFixed(2)}</td>
      <td class="num">${x.count_b}</td>
      <td class="num">${x.rate_b.toFixed(2)}</td>
      <td class="num strong">${x.score.toFixed(2)}</td>
      <td class="arch-where">${esc((x.labels_b || []).slice(0, 4).join(", "))}${
        (x.labels_b || []).length > 4 ? ` <span class="muted">+${x.labels_b.length - 4}</span>` : ""}</td>
    </tr>`).join("");
  return head + `
    <table class="arch-table">
      <thead><tr>
        <th>word</th>
        <th class="num" title="occurrences in the earlier work">A ×</th>
        <th class="num" title="per 1000 words in the earlier work">A /1000</th>
        <th class="num" title="occurrences in the younger work">B ×</th>
        <th class="num" title="per 1000 words in the younger work">B /1000</th>
        <th class="num" title="log2 ratio of the two rates">collapse</th>
        <th>where in B</th>
      </tr></thead>
      <tbody>${body}</tbody>
    </table>
    <div id="arch-evidence" class="arch-evidence"></div>`;
}

